# Clerk Authentication
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Sentry (Error Monitoring)
SENTRY_DSN=https://your_sentry_dsn@o000000.ingest.sentry.io/0000000
EXPO_PUBLIC_SENTRY_DSN=https://your_sentry_dsn@o000000.ingest.sentry.io/0000000

# App Configuration
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_VERSION=1.0.0

# Feature Flags (Optional)
EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ENABLE_CRASH_REPORTING=false

# ==========================================
# AI Configuration (SERVER-ONLY)
# ==========================================
# ⚠️ CRITICAL SECURITY WARNING ⚠️
#
# These API keys are SERVER-ONLY and must NEVER be prefixed with EXPO_PUBLIC_
# They should ONLY be accessed in API routes (/app/api/) and NEVER in client code
# Expo will NOT bundle these keys in the client app
#
# NEVER DO THIS:
# - EXPO_PUBLIC_OPENAI_API_KEY=... ❌ (exposes key to clients)
# - import OPENAI_API_KEY in client components ❌ (won't work anyway)
#
# ALWAYS DO THIS:
# - OPENAI_API_KEY=... ✅ (server-only)
# - Access only in /app/api/ routes ✅
# ==========================================

# OpenAI Configuration (Default Provider)
OPENAI_API_KEY=sk-your_openai_api_key_here

# AI Provider Selection (openai | anthropic | google | local)
AI_PROVIDER=openai

# Optional: Anthropic (Claude)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Google (Gemini)
# GOOGLE_AI_API_KEY=your_google_api_key_here
